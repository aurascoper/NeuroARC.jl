{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroarc.org/schemas/neuroarc-rule-proposal-v1.schema.json",
  "title": "NeuroARC Rule Proposal",
  "description": "Validated proposal envelope for candidate symbolic grid transformation rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_type",
    "parameter_hypotheses"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "CorridorWireTraceRule",
        "GeodesicBarrierFloodRule",
        "PeriodicStampWithPriorityRule",
        "MarkerLineReflectionRule",
        "ExactCoverPolyominoRule"
      ]
    },
    "parameter_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "color",
              "text",
              "coordinates0",
              "color_map"
            ]
          },
          "value": {}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "color"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "text"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "coordinates0"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "row0",
                      "column0"
                    ],
                    "properties": {
                      "row0": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "column0": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "color_map"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source_color",
                      "target_color"
                    ],
                    "properties": {
                      "source_color": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9
                      },
                      "target_color": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "string"
    }
  }
}
